# Shared by Docker Compose and Spring Boot (Java properties syntax).
# Use plain KEY=value lines, without quotes, export, or inline comments.
# For passwords, use letters/digits only (e.g. a generated hexadecimal value)
# to avoid different handling of $, #, quotes, and backslashes.
POSTGRES_DB=quest504
POSTGRES_USER=quest504
# Set a private local password in .env; never commit .env.
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
